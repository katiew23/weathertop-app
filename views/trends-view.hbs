{{> menu}}
<section class="section">
  <h1 class="title">Temperature, Wind Speed & Pressure Trends for {{station.title}}</h1>

  <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
    <div id="tempChart" style="flex: 1; min-width: 300px; max-width: 32%; height: 300px;"></div>
    <div id="windChart" style="flex: 1; min-width: 300px; max-width: 32%; height: 300px;"></div>
    <div id="pressureChart" style="flex: 1; min-width: 300px; max-width: 32%; height: 300px;"></div>
  </div>
  
  <a href="/station/{{station._id}}" class="button is-link" style="margin-top: 1em;">Back to Station</a>
</section>

<style>
  @media (max-width: 768px) {
    #tempChart, #windChart, #pressureChart {
      min-width: auto !important; /* remove fixed min-width on mobile */
      max-width: 100% !important;
      height: 250px !important; /* reduce height on mobile */
    }
  }
</style>

<script>
  const labels = {{{dates}}};
  const temps = {{{temperatures}}};
  const winds = {{{winds}}};
  const pressures = {{{pressures}}};

  // Temperature Chart
  new frappe.Chart("#tempChart", {
    title: "Temperature (°C)",
    data: {
      labels: labels,
      datasets: [{ name: "Temperature", values: temps }]
    },
    type: "line",
    height: 300,
    colors: ["blue"]
  });

  // Wind Speed Chart
  new frappe.Chart("#windChart", {
    title: "Wind Speed (km/h)",
    data: {
      labels: labels,
      datasets: [{ name: "Wind Speed", values: winds }]
    },
    type: "line",
    height: 300,
    colors: ["green"]
  });

  // Pressure Chart
  new frappe.Chart("#pressureChart", {
    title: "Pressure (hPa)",
    data: {
      labels: labels,
      datasets: [{ name: "Pressure", values: pressures }]
    },
    type: "line",
    height: 300,
    colors: ["purple"]
  });
</script>
