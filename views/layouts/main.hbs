<!DOCTYPE html>
<html lang="en-IE">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{title}}</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@0.9.4/css/bulma.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
  <style>
    /* Reset & base */
    html, body {
      height: 100%;
      margin: 0;
      padding: 0;
      background-color: #000;
      color: #eee;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Container */
    .container {
      background-color: #000;
      padding: 2em;
      border-radius: 8px;
      box-shadow: 0 0 15px rgba(255,255,255,0.1);
      min-height: 100vh;
    }

    /* Navbar */
    .navbar {
      background-color: #111 !important;
      border-bottom: 1px solid #222;
      min-height: 100px;
      align-items: center;
      color: white !important;
    }
    .navbar .button {
      background-color: #555 !important;
      color: #eee !important;
      border-color: #666 !important;
    }
    .navbar .button.is-active,
    .navbar .button:hover {
      background-color: #777 !important;
      color: white !important;
      border-color: #888 !important;
    }

    /* Links */
    a {
      color: #4a90e2;
      text-decoration: none;
    }
    a:hover {
      color: #66b3ff;
      text-decoration: underline;
    }

    /* Typography */
    .title, .subtitle, .columns p, .columns strong,
    .help-text, h4, legend, .form-header, label[for="addReading"] {
      color: #eee !important;
    }

    /* Box */
    .box {
      background-color: #222;
      color: #eee;
      border-radius: 8px;
      padding: 1em;
      margin-bottom: 1.5em;
      box-shadow: 0 0 10px rgba(255,255,255,0.1);
    }

    /* Table */
    table.table {
      background-color: #222;
      color: #eee;
      width: 100%;
    }
    table.table thead th {
      color: #eee;
    }
    table.table tbody tr {
      background-color: #111 !important;
      color: #eee !important;
    }
    table.table tbody tr:nth-child(even) {
      background-color: #111 !important; /* no striping */
    }
    table.table a.button {
      color: #eee !important;
    }

    /* Card */
    .card {
      background-color: black !important;
      color: white !important;
    }
    .card-header-title,
    .card-content p,
    .card-content strong,
    .card-content span,
    .card p {
      color: white !important;
    }
    .card-content img {
      filter: none !important;
    }

    /* Form controls */
    label {
      background-color: #111;
      color: #eee !important;
      padding: 0.5em 0.75em;
      display: inline-block;
      border-radius: 4px;
      margin-bottom: 0.3em;
    }
    input, select, textarea {
      background-color: #111 !important;
      color: #eee !important;
      border: 1px solid #444 !important;
      padding: 0.5em 0.75em;
      border-radius: 4px;
      margin-bottom: 1em;
    }
    input::placeholder, select::placeholder, textarea::placeholder {
      color: #aaa !important;
    }

    /* Buttons */
    button, .button {
      color: #eee !important;
    }
    .button.is-info {
      background-color: #3273dc;
      color: white;
    }
    .button.is-danger {
      background-color: #ff3860;
      color: white;
    }
    .button.is-small.is-info, .button.is-small.is-danger {
      color: white;
    }
  </style>
</head>
<body>
  {{{body}}}

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const burger = document.querySelector('.navbar-burger');
      const menu = document.getElementById('navbarMenu');
      if (burger && menu) {
        burger.addEventListener('click', () => {
          burger.classList.toggle('is-active');
          menu.classList.toggle('is-active');
        });
      }
      if ("{{active}}") {
        const activeButton = document.getElementById("{{active}}");
        if (activeButton) activeButton.classList.add("is-primary");
      }
    });
  </script>
</body>
</html>
