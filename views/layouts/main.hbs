<!DOCTYPE html>
<html lang="en-IE">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{title}}</title>

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bulma@0.9.4/css/bulma.min.css"
  />
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"
  />

  <style>
    .box > h3.title {
      color: white !important;
      font-weight: 600;
      text-shadow: 0 0 3px rgba(0,0,0,0.7);
    }

    .custom-logo {
      height: 600px;
      width: auto;
    }

    .navbar {
      min-height: 100px;
      align-items: center;
    }

    .tile-card {
      background-color: #1a1a1a !important;
      color: white !important;
      padding: 1.5em;
      border-radius: 6px;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.7);
      margin-bottom: 1em;
      font-weight: 600;
      text-shadow: 0 0 3px rgba(0, 0, 0, 0.7);
    }

    .tile-card strong,
    .tile-card p {
      color: #fff !important;
      font-weight: 600;
      text-shadow: 0 0 2px rgba(0, 0, 0, 0.5);
    }
    .tile-card h3.title {
      color: white !important;
      font-weight: 600;
      text-shadow: 0 0 3px rgba(0,0,0,0.7);
   }


    .columns.is-multiline {
      background: transparent !important;
    }

    .columns.is-mobile.is-vcentered > .column,
    .columns.is-mobile.is-vcentered.is-multiline > .column {
      background: transparent !important;
      padding: 0 !important;
    }
  </style>
</head>

<body>
  <div class="container">
    {{{body}}}
  </div>
</body>
</html>
