{{> menu}}

<section class="section">
  <h1 class="title">{{station.title}}</h1>
  <p class="subtitle is-6">📍 Location: {{station.latitude}}, {{station.longitude}}</p>

  {{#if reports.length}}
    <div class="box mb-5">
      <div class="columns is-multiline is-mobile is-vcentered">
        <div class="column is-one-fifth has-text-centered">
          <p><strong>Weather</strong></p>
          {{#if latestReport}}
            <img src="http://openweathermap.org/img/wn/{{latestReport.iconCode}}@2x.png"
                 alt="Weather Icon"
                 style="height:80px;width:80px;">
            <p>{{latestReport.description}}</p>
          {{else}}
            <p>N/A</p>
          {{/if}}
        </div>

        <div class="column is-one-fifth">
          <p><strong>🌡️ Temperature</strong></p>
          <p>
            Min: {{#if minTemp}}{{minTemp}}°C{{else}}N/A{{/if}}
            /
            Max: {{#if maxTemp}}{{maxTemp}}°C{{else}}N/A{{/if}}
          </p>
        </div>

        <div class="column is-one-fifth">
          <p><strong>💨 Wind Speed</strong></p>
          <p>
            Min: {{#if minWind}}{{minWind}} km/h{{else}}N/A{{/if}}
            /
            Max: {{#if maxWind}}{{maxWind}} km/h{{else}}N/A{{/if}}
          </p>
        </div>

        <div class="column is-one-fifth">
          <p><strong>🌬️ Pressure</strong></p>
          <p>
            Min: {{#if minPressure}}{{minPressure}} hPa{{else}}N/A{{/if}}
            /
            Max: {{#if maxPressure}}{{maxPressure}} hPa{{else}}N/A{{/if}}
          </p>
        </div>
      </div>
    </div>

    <div class="box mb-5">
      <h2 class="subtitle">Latest Report</h2>
      <div class="columns is-mobile is-vcentered">
        <div class="column is-narrow">
          <img src="http://openweathermap.org/img/wn/{{latestReport.iconCode}}@2x.png"
               alt="Latest Icon"
               style="height:60px;width:60px;">
        </div>
        <div class="column">
          <p><strong>{{latestReport.description}}</strong></p>
          <p>Temp: {{latestReport.temperature}}°C</p>
          <p>Wind: {{latestReport.windSpeed}} km/h {{latestReport.windDirection}}</p>
          <p>Pressure: {{latestReport.pressure}} hPa</p>
        </div>
      </div>
    </div>
  {{else}}
    <p>No reports yet for this station.</p>
  {{/if}}

  <table class="table is-fullwidth is-striped">
    <thead>
      <tr>
        <th>Code</th>
        <th>Icon</th>
        <th>Date/Time</th>
        <th>Temperature (°C)</th>
        <th>Wind Speed (km/h)</th>
        <th>Wind Direction</th>
        <th>Pressure (hPa)</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {{#each reports}}
        <tr>
          <td>{{code}}</td>
          <td>
            <img src="http://openweathermap.org/img/wn/{{iconCode}}@2x.png"
                 alt="Icon"
                 style="height:40px;width:40px;">
          </td>
          <td>{{formatDateTime date}}</td> 
          <td>{{temperature}}</td>
          <td>{{windSpeed}}</td>
          <td>{{windDirection}}</td>
          <td>{{pressure}}</td>
          <td>
            <a href="/station/{{../station._id}}/editreport/{{_id}}" class="button is-small is-info">Edit</a>
            <a href="/station/{{../station._id}}/deletereport/{{_id}}" class="button is-small is-danger" onclick="return confirm('Delete this report?')">Delete</a>
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>

  {{> add-report}}

  
  <button id="autoGenerateBtn" class="button is-danger" style="margin-top: 1em;">Auto Generate Reading</button>
</section>

<script>
  const stationId = "{{station._id}}";

document.getElementById('autoGenerateBtn').addEventListener('click', async () => {
  try {
    const response = await fetch(`/station/${stationId}/report/live`, { method: 'POST' }); // <-- add method: 'POST'
    if (!response.ok) throw new Error('Failed to fetch live weather data');

    const liveReport = await response.json();
    
    window.location.reload();
  } catch (error) {
    alert('Error auto-generating report: ' + error.message);
    console.error(error);
  }
});

</script>
