{{> menu}}

<section class="section">
  <div class="title">
    {{station.title}}
  </div>

  <!-- Report Table -->
  <table class="table is-fullwidth">
    <thead>
      <tr>
        <th>Code</th>
        <th>Icon</th>
        <th>Temperature (°C)</th>
        <th>Wind Speed (km/h)</th>
        <th>Pressure (hPa)</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {{#each reports}}
        <tr>
          <td>{{code}}</td>
          <td>
            <img src="https://openweathermap.org/img/wn/{{getIconForCode code}}@2x.png" alt="Weather Icon" />
          </td>
          <td>{{temperature}}</td>
          <td>{{windSpeed}}</td>
          <td>{{pressure}}</td>
          <td>
            <a href="/station/{{../station._id}}/editreport/{{_id}}" class="button is-small is-info">Edit</a>
<a href="/station/{{../station._id}}/deletereport/{{_id}}" class="button is-small is-danger">Delete</a>


          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>

  <!-- Add New Report -->
  {{> add-report}}
</section>


