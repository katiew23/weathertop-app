{{> menu active="dashboard"}}
<section class="section">
  <h2 class="title is-4" style="margin-bottom: 1.5em;">Welcome, {{user.name}}</h2>
  <div id="dashboardMap"></div>

  <div class="columns is-multiline">
    {{#each stations}}
      <div class="column is-full-mobile is-half-tablet is-one-third-desktop">
        <div class="card" style="margin-bottom: 1.5em;">
          <header class="card-header">
            <p class="card-header-title">{{this.title}}</p>
          </header>

          <div class="card-content">
            {{#if this.latestReport}}
              <div class="columns is-mobile is-vcentered">
                <div class="column has-text-centered">
                  <img src="https://openweathermap.org/img/wn/{{this.latestReport.iconCode}}@2x.png" alt="Weather icon" style="width:48px;">
                  <p><strong>Weather</strong></p>
                  <p>{{this.latestReport.description}}</p>
                </div>
                <div class="column has-text-centered">
                  <p><strong>🌡️ Temperature</strong></p>
                  <p>{{roundToDecimal this.latestReport.temperature 1}}°C</p>
                </div>
                <div class="column has-text-centered">
                  <p><strong>💨 Wind Speed</strong></p>
                  <p>{{roundToDecimal this.latestReport.windSpeed 1}} km/h</p>
                </div>
                <div class="column has-text-centered">
                  <p><strong>📊 Pressure</strong></p>
                  <p>{{roundToDecimal this.latestReport.pressure 1}} hPa</p>
                </div>
              </div>
            {{else}}
              <p>No reports available.</p>
            {{/if}}
          </div>

          <footer class="card-footer">
            <a href="/station/{{this._id}}" class="card-footer-item button is-small is-info">View Station</a>
            <a href="/dashboard/deletestation/{{this._id}}" class="card-footer-item button is-small is-danger">Delete Station</a>
          </footer>
        </div>
      </div>
    {{/each}}
  </div>

  <p class="help-text">
    Need help with coordinates?  
    <a href="/help" target="_blank">See common locations and their lat/lon here</a> or use 
    <a href="https://www.latlong.net/" target="_blank" rel="noopener noreferrer">LatLong.net</a>.
  </p>
  {{> add-stations}}
</section>

<style>
  #dashboardMap {
    width: 100%;
    max-width: 100%;
    height: 400px;
    margin-bottom: 2em;
  }

  @media (max-width: 768px) {
    #dashboardMap {
      height: 250px;
    }
  }  
 
</style>



<script src="https://unpkg.com/leaflet@1.9.3/dist/leaflet.js"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.3/dist/leaflet.css" />
<script>
  const stations = {{{json stations}}};
  const map = L.map('dashboardMap').setView([53.3498, -6.2603], 7);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; OpenStreetMap contributors'
  }).addTo(map);
  const markers = [];
  stations.forEach(station => {
    if (station.latitude && station.longitude) {
      const marker = L.marker([station.latitude, station.longitude])
        .addTo(map)
        .bindPopup(station.title)
      markers.push(marker);
    }
  });
  if (markers.length > 0) {
    const group = L.featureGroup(markers);
    map.fitBounds(group.getBounds().pad(0.2));
  }
</script>
