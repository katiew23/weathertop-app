{{#each stations}}
<div class="box box-link-hover-shadow">
  <h2 class="title">
    {{title}}
  </h2>
  <a href="/station/{{_id}}" class="button">
    {{> icons/open }}
  </a>
  <a href="/dashboard/deletestation/{{_id}}" class="button is-danger">
    {{> icons/delete }}
    <span class="ml-1">Delete Weather Station</span>
  </a>
</div>
{{/each}}



