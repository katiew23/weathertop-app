<form action="/station/{{station._id}}/addreport" method="POST">
  <label class="label">Add Reading</label>
  <div class="field is-horizontal">
    <div class="field-body">
      <div class="field">
        <input class="input" type="number" placeholder="Code" name="code" required>
      </div>
      <div class="field">
        <input class="input" type="number" placeholder="Temperature (°C)" name="temperature" required>
      </div>
      <div class="field">
        <input class="input" type="number" placeholder="Wind Speed (km/h)" name="windSpeed" required>
      </div>
      <div class="field">
        <input class="input" type="number" placeholder="Pressure (hPa)" name="pressure" required>
      </div>
    </div>
  </div>
  <button class="button is-link">Add Report</button>
</form>

