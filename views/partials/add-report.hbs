<form action="/station/{{station._id}}/addreport" method="POST">
  <label class="label">Add Reading</label>
  <div class="field is-horizontal">
    <div class="field-body">

      <div class="field">
        <label class="label">Code</label>
        <div class="control">
          <div class="select is-fullwidth">
            <select name="code" required>
              <option value="">Select Weather Condition</option>
              {{#each weatherCodes}}
                <option value="{{code}}">{{code}} - {{description}}</option>
              {{/each}}
            </select>
          </div>
        </div>
      </div>

      <div class="field">
        <label class="label">Temperature (°C)</label>
        <div class="control">
          <input class="input" type="number" name="temperature" placeholder="00.0" step="0.1" required>
        </div>
      </div>

      <div class="field">
        <label class="label">Wind Speed (km/h)</label>
        <div class="control">
          <input class="input" type="number" name="windSpeed" placeholder="00.0" step="0.1" required>
        </div>
      </div>

      <div class="field">
        <label class="label">Wind Direction (°)</label>
        <div class="control">
          <input class="input" type="number" name="windDirection" placeholder="000" min="0" max="360" required>
        </div>
      </div>

      <div class="field">
        <label class="label">Pressure (hPa)</label>
        <div class="control">
          <input class="input" type="number" name="pressure" placeholder="000" step="0.1" required>
        </div>
      </div>

    </div>
  </div>
  <button type="submit" class="button is-link">Add Report</button>
</form>
