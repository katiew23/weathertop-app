{{> menu}}

<section class="section">
  <h1 class="title">{{station.title}}</h1>
  <p class="subtitle is-6">📍 Location: {{station.latitude}}, {{station.longitude}}</p>

  {{!— Only show once we have at least one report —}}
  {{#if latestReport}}
    <div class="box mb-5">
      <h2 class="subtitle">Latest Report</h2>
      <div class="columns is-mobile is-vcentered">
        <div class="column is-narrow has-text-centered">
          <p><strong>{{latestReport.description}}</strong></p>
          <img
            src="http://openweathermap.org/img/wn/{{latestReport.iconCode}}@2x.png"
            alt="Icon"
            style="height:80px;width:80px;"
          />
        </div>
        <div class="column">
          <p><small>Date: {{latestReport.date}}</small></p>
          <p>🌡️ Temp: {{latestReport.temperature}}°C (Min: {{minTemp}}°C, Max: {{maxTemp}}°C)</p>
          <p>💨 Wind: {{latestReport.windSpeed}} km/h {{latestReport.windDirection}} (Min: {{minWind}}, Max: {{maxWind}})</p>
          <p>🌬️ Pressure: {{latestReport.pressure}} hPa (Min: {{minPressure}}, Max: {{maxPressure}})</p>
        </div>
      </div>
    </div>
  {{else}}
    <p>No reports yet for this station.</p>
  {{/if}}

  <table class="table is-fullwidth is-striped">
    <thead>
      <tr>
        <th>Code</th>
        <th>Icon</th>
        <th>Date/Time</th>
        <th>Temp (°C)</th>
        <th>Wind (km/h)</th>
        <th>Direction</th>
        <th>Pressure (hPa)</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {{#each reports}}
        <tr>
          <td>{{code}}</td>
          <td>
            <img
              src="http://openweathermap.org/img/wn/{{iconCode}}@2x.png"
              alt="Icon"
              style="height:40px;width:40px;"
            />
          </td>
          <td>{{date}}</td>
          <td>{{temperature}}</td>
          <td>{{windSpeed}}</td>
          <td>{{windDirection}}</td>
          <td>{{pressure}}</td>
          <td>
            <a href="/station/{{../station._id}}/editreport/{{_id}}" class="button is-small is-info">Edit</a>
            <a href="/station/{{../station._id}}/deletereport/{{_id}}" class="button is-small is-danger" onclick="return confirm('Delete this report?')">Delete</a>
          </td>
        </tr>
      {{/each}}
    </tbody>
  </table>

  {{> add-report}}
</section>
