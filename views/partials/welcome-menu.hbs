<nav class="navbar" role="navigation" aria-label="main navigation">
  <div class="navbar-brand">
    {{> brand}}
  
    <a role="button" class="navbar-burger" aria-label="menu" aria-expanded="false" data-target="navbarBasicExample">
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </a>
  </div>

  <div id="navbarBasicExample" class="navbar-menu">
    <div class="navbar-end">
      <div class="navbar-item">
        <div class="buttons">
          <a class="button is-light" id="login" href="/login">Log in</a>
          <a class="button is-primary" id="signup" href="/signup">Sign up</a>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
    document.addEventListener('DOMContentLoaded', () => {
    const burger = document.querySelector('.navbar-burger');
    const menu = document.getElementById('navbarBasicExample');

    burger.addEventListener('click', () => {
      burger.classList.toggle('is-active');
      menu.classList.toggle('is-active');
    });

    if ("{{active}}") {
      const activeButton = document.getElementById("{{active}}");
      if (activeButton) activeButton.classList.add("is-primary");
    }
  });
</script>
