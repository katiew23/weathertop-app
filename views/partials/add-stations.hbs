<form action="/dashboard/addstation" method="POST">
  <div class="field">
    <label class="label">Station Name</label>
    <input class="input" type="text" placeholder="Enter station name" name="title" required>
  </div>
  <div class="field">
    <label class="label">Location</label>
    <input class="input" type="text" placeholder="e.g. Waterford, Ireland" name="location">
  </div>
  <div class="field">
  <label class="label">Latitude</label>
  <div class="control">
    <input class="input" type="number" name="latitude" step="any" required placeholder="e.g. 52.661">
  </div>
</div>
<div class="field">
  <label class="label">Longitude</label>
  <div class="control">
    <input class="input" type="number" name="longitude" step="any" required placeholder="e.g. -8.626">
  </div>
</div>
  <button class="button is-link">Add Station</button>
</form>
